# ─── Site ─────────────────────────────────────────────────────────────
# URL publique du site (CORS/CSRF, liens absolus), lue au démarrage et non au build. Sans slash final.
SERVER_URL=http://localhost:3000

# Secret de signature des sessions Payload : 32 caractères minimum, unique par environnement.
# Générer avec : node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
PAYLOAD_SECRET=

# ─── Base de données ──────────────────────────────────────────────────
# Local : docker compose. Sur Vercel avec l'intégration Supabase, inutile : POSTGRES_URL est injectée et utilisée.
DATABASE_URI=postgres://monaco:monaco@localhost:5432/monaco_united
# Certificat CA si l'hébergeur n'est pas Supabase (celui de Supabase est déjà embarqué). PEM sur une ligne avec \n.
# DATABASE_CA_CERT=
# Connexions max par instance (défaut : 3 sur Vercel, 10 ailleurs).
# DATABASE_POOL_MAX=

# ─── Médias ───────────────────────────────────────────────────────────
# Sur Vercel : créer un store Blob (Storage > Blob), BLOB_READ_WRITE_TOKEN est injecté et utilisé.
# Sinon S3 (ci-dessous), sinon disque (dossier MEDIA_DIR, défaut ./media).
# MEDIA_DIR=/data/media
# Stockage objet S3 (Supabase Storage : Settings > Storage > S3 Connection). Bucket public.
# S3_BUCKET=media
# S3_ENDPOINT=https://<ref>.storage.supabase.co/storage/v1/s3
# S3_REGION=eu-west-3
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=
# URL publique des fichiers (servis par le CDN, sans passer par l'app)
# S3_PUBLIC_URL=https://<ref>.supabase.co/storage/v1/object/public/media
# Upload direct navigateur -> bucket (contourne la limite de 4,5 Mo de Vercel). Défaut : activé.
# S3_CLIENT_UPLOADS=true

# ─── Synchronisation des données sportives ────────────────────────────
# Secret de la tâche planifiée /cron/sync (Vercel l'envoie en « Authorization: Bearer »). 16 caractères minimum.
CRON_SECRET=
# Source des données : vide = aucune (saisie manuelle dans l'admin). Prévu : scorenco.
# SYNC_PROVIDER=

# ─── E-mail (facultatif) : notifications des messages de contact ──────
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASS=
# SMTP_FROM_ADDRESS=no-reply@monacounited.mc
# SMTP_FROM_NAME=Monaco United
