# URL publique du site (CORS/CSRF, liens absolus), lue au démarrage et non au build. Sans slash final.
SERVER_URL=http://localhost:3000

# Connexion PostgreSQL
DATABASE_URI=postgres://monaco:monaco@localhost:5432/monaco_united

# Secret de signature des sessions Payload : 32 caractères minimum, unique par environnement.
# Générer avec : node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
PAYLOAD_SECRET=

# Dossier des médias uploadés (volume persistant en prod). Défaut : ./media
# MEDIA_DIR=/data/media

# SMTP (facultatif) : notifications des messages de contact
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASS=
# SMTP_FROM_ADDRESS=no-reply@monacounited.mc
# SMTP_FROM_NAME=Monaco United
